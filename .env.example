# ============================================================
# Bersabeh Clinic Platform — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit .env — it's git-ignored on purpose.
# ============================================================

# ---- Runtime ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
# CORS origins for Expo (web dev server uses 8081, Expo Go uses LAN IP)
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql+asyncpg://bersabeh:bersabeh_dev_password@localhost:5432/bersabeh_db
DATABASE_URL_SYNC=postgresql+psycopg://bersabeh:bersabeh_dev_password@localhost:5432/bersabeh_db

# ---- JWT ----
# Generate real secrets with:  openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET_KEY=change_me_too_generate_separately
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Email (MailHog in dev) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@bersabehclinic.com
MAIL_FROM_NAME="Bersabeh Clinic"
MAIL_USE_TLS=false

# ---- File uploads ----
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=10
MAX_PDF_MB=25
MAX_VIDEO_MB=100

# ---- Rate limiting ----
AUTH_RATE_LIMIT=5/15minutes

# ---- App ----
APP_NAME="Bersabeh Clinic Platform"
APP_VERSION=0.1.0

# ---- Jitsi (video calls) ----
JITSI_BASE_URL=https://meet.jit.si
