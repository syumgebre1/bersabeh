from typing import Annotated
"""
Vital signs endpoints.

Role permissions:
                            Patient  Doctor    Nurse  Reception  Lab  Admin
  POST   /vitals              ❌      ✅        ✅     ❌         ❌   ✅
  GET    /vitals              own     own(pt)   all    all        ❌   all
  GET    /vitals/{id}         own     own(pt)   all    all        ❌   all
  GET    /vitals/patient/{pid} own    own(pt)   all    all        ❌   all

Where:
  - "own" (patient)  = only their own vitals
  - "own(pt)" (doctor) = vitals of patients this doctor has encounters with
                        (we simplify to "all" for now — a full filter
                        would require a join on encounters)
  - "all" (nurse, reception) = all vitals
"""

import uuid
from datetime import datetime, timezone

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.deps import CurrentUser
from app.db.session import get_db
from app.models.encounter import Encounter
from app.models.user import User, UserRole
from app.models.vital import Vital
from app.schemas.vital import VitalBrief, VitalCreate, VitalRead


router = APIRouter(prefix="/vitals", tags=["vitals"])


@router.get("/pending")
async def pending_vitals(
    window_hours: int = 8,
    db: AsyncSession = Depends(get_db),
    _: Annotated[User, Depends(require_roles(
        UserRole.NURSE, UserRole.DOCTOR, UserRole.ADMIN, UserRole.SUPER_ADMIN
    ))] = None,
):
    """
    Patients with active bed assignments who have no vitals recorded
    in the last `window_hours` hours.
    """
    from datetime import datetime, timedelta, timezone
    from sqlalchemy import select as _select
    from app.models.bed_assignment import BedAssignment
    from app.models.vital import Vital
    from app.models.user import User as _User

    cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)

    # All active inpatients
    assignments = (
        await db.execute(
            _select(BedAssignment).where(BedAssignment.status == "active")
        )
    ).scalars().all()
    if not assignments:
        return []

    patient_ids = [a.patient_id for a in assignments]

    # Latest vital per patient
    latest_stmt = (
        _select(Vital.patient_id, Vital.recorded_at)
        .where(Vital.patient_id.in_(patient_ids))
        .order_by(Vital.patient_id, Vital.recorded_at.desc())
    )
    rows = (await db.execute(latest_stmt)).all()
    latest: dict = {}
    for pid, ts in rows:
        if pid not in latest:
            latest[pid] = ts

    out = []
    for a in assignments:
        last = latest.get(a.patient_id)
        if last is None or last < cutoff:
            patient = (
                await db.execute(_select(_User).where(_User.id == a.patient_id))
            ).scalar_one_or_none()
            out.append({
                "patient_id": str(a.patient_id),
                "patient_name": patient.full_name if patient else "—",
                "room_id": str(a.room_id),
                "last_vitals_at": last.isoformat() if last else None,
                "due_since": cutoff.isoformat(),
            })
    return out


# ============================================================
# Helpers
# ============================================================
def _is_adminish(user: User) -> bool:
    return user.role in (UserRole.ADMIN, UserRole.SUPER_ADMIN)


def _can_log_vitals(user: User) -> bool:
    return user.role in (UserRole.NURSE, UserRole.DOCTOR) or _is_adminish(user)


def _can_view(user: User, v: Vital) -> bool:
    if user.role == UserRole.PATIENT:
        return v.patient_id == user.id
    if user.role in (UserRole.NURSE, UserRole.DOCTOR, UserRole.RECEPTION, UserRole.ADMIN, UserRole.SUPER_ADMIN):
        return True
    return False


async def _get_vital_or_404(db: AsyncSession, vital_id: uuid.UUID) -> Vital:
    result = await db.execute(select(Vital).where(Vital.id == vital_id))
    v = result.scalar_one_or_none()
    if v is None:
        raise HTTPException(status_code=404, detail="Vital reading not found")
    return v


# ============================================================
# POST /vitals
# ============================================================
@router.post(
    "",
    response_model=VitalRead,
    status_code=status.HTTP_201_CREATED,
    summary="Log a vital reading (nurse/doctor)",
)
async def create_vital(
    payload: VitalCreate,
    patient_id: uuid.UUID = Query(..., description="Patient whose vitals are being logged"),
    current_user: CurrentUser = None,
    db: AsyncSession = Depends(get_db),
) -> VitalRead:
    if not _can_log_vitals(current_user):
        raise HTTPException(status_code=403, detail="Only nurses and doctors can log vitals")

    # Verify patient exists.
    patient_result = await db.execute(select(User).where(User.id == patient_id))
    patient = patient_result.scalar_one_or_none()
    if patient is None or patient.is_deleted or patient.role != UserRole.PATIENT:
        raise HTTPException(status_code=400, detail="Invalid patient_id")

    # If encounter_id given, verify it belongs to this patient.
    if payload.encounter_id is not None:
        enc_result = await db.execute(
            select(Encounter).where(Encounter.id == payload.encounter_id)
        )
        enc = enc_result.scalar_one_or_none()
        if enc is None:
            raise HTTPException(status_code=404, detail="Encounter not found")
        if enc.patient_id != patient_id:
            raise HTTPException(status_code=400, detail="Encounter does not belong to this patient")

    v = Vital(
        patient_id=patient_id,
        encounter_id=payload.encounter_id,
        recorded_by_id=current_user.id,
        temperature_c=payload.temperature_c,
        heart_rate_bpm=payload.heart_rate_bpm,
        respiratory_rate=payload.respiratory_rate,
        bp_systolic=payload.bp_systolic,
        bp_diastolic=payload.bp_diastolic,
        spo2_percent=payload.spo2_percent,
        weight_kg=payload.weight_kg,
        height_cm=payload.height_cm,
        pain_scale=payload.pain_scale,
        notes=payload.notes,
        recorded_at=payload.recorded_at or datetime.now(timezone.utc),
    )
    db.add(v)
    await db.commit()
    await db.refresh(v)
    return VitalRead.model_validate(v)


# ============================================================
# GET /vitals
# ============================================================
@router.get(
    "",
    response_model=list[VitalBrief],
    summary="List vitals (role-filtered)",
)
async def list_vitals(
    current_user: CurrentUser,
    db: AsyncSession = Depends(get_db),
    limit: int = Query(100, ge=1, le=500),
    offset: int = Query(0, ge=0),
) -> list[VitalBrief]:
    if current_user.role == UserRole.LAB:
        raise HTTPException(status_code=403, detail="Lab staff cannot view vitals")

    stmt = select(Vital)
    if current_user.role == UserRole.PATIENT:
        stmt = stmt.where(Vital.patient_id == current_user.id)
    # Doctor, Nurse, Reception, Admin: all (simplified)

    stmt = stmt.order_by(Vital.recorded_at.desc()).limit(limit).offset(offset)
    result = await db.execute(stmt)
    return [VitalBrief.model_validate(v) for v in result.scalars().all()]


# ============================================================
# GET /vitals/patient/{patient_id}
# ============================================================
@router.get(
    "/patient/{patient_id}",
    response_model=list[VitalRead],
    summary="All vitals for a patient (for trend charts)",
)
async def patient_vitals(
    patient_id: uuid.UUID,
    current_user: CurrentUser,
    db: AsyncSession = Depends(get_db),
    limit: int = Query(50, ge=1, le=500),
) -> list[VitalRead]:
    if current_user.role == UserRole.LAB:
        raise HTTPException(status_code=403, detail="Lab staff cannot view vitals")
    if current_user.role == UserRole.PATIENT and patient_id != current_user.id:
        raise HTTPException(status_code=403, detail="Not your vitals")

    stmt = (
        select(Vital)
        .where(Vital.patient_id == patient_id)
        .order_by(Vital.recorded_at.desc())
        .limit(limit)
    )
    result = await db.execute(stmt)
    return [VitalRead.model_validate(v) for v in result.scalars().all()]


# ============================================================
# GET /vitals/{id}
# ============================================================
@router.get(
    "/{vital_id}",
    response_model=VitalRead,
    summary="Get one vital reading",
)
async def get_vital(
    vital_id: uuid.UUID,
    current_user: CurrentUser,
    db: AsyncSession = Depends(get_db),
) -> VitalRead:
    v = await _get_vital_or_404(db, vital_id)
    if not _can_view(current_user, v):
        raise HTTPException(status_code=403, detail="Not allowed to view this reading")
    return VitalRead.model_validate(v)
